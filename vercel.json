{
  "version": 2,
  "builds": [
    {
      "src": "code/src/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "code/landing/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "code/src/main.py"
    },
    {
      "src": "/(.*)",
      "dest": "code/landing/$1"
    }
  ],
  "functions": {
    "code/src/main.py": {
      "includeFiles": "code/src/alter_db.sqlite"
    }
  }
}
